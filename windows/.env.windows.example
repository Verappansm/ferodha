# Copy to windows/.env.windows (git-ignored) and fill in. Read by
# windows/start-windows.ps1 and windows/test-windows.sh.
# Never commit a real key.

# The Linux Docker host running Kafka - exactly what windows/kafka-linux.sh
# prints at the end. localhost only if Docker runs in WSL2 on this same PC.
KAFKA_BOOTSTRAP_SERVERS=192.168.1.20:9092
# Where the browser reaches Kafka UI (on that same Linux host).
KAFKA_UI_URL=http://192.168.1.20:8091

# Native Windows Postgres. The database is created if missing, and the
# Sprint 3 schema + seed are applied once to an empty database.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tradedb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# Optional: folder holding psql.exe, if it isn't on PATH. When unset, the
# script also looks under C:\Program Files\PostgreSQL\<version>\bin.
PSQL_BIN_DIR=

# Shared by trade-api (verifies) and auth-service (signs). At least 32 chars.
JWT_SECRET=dev-only-jwt-signing-secret-please-change-later

# Real quotes. trade-executor's price feed uses them as the anchors for its
# live ticks and charts (both profiles), and every fill is priced at that live
# tick. Left empty, there are no live prices, and orders still make the full
# Kafka round trip but resolve to REJECTED / PRICE_UNAVAILABLE.
FAUXNANCE_API_URL=
FAUXNANCE_API_KEY=
POLL_INTERVAL_SECONDS=60

# Ports the Windows services listen on.
TRADE_API_PORT=8080
TRADE_EXECUTOR_PORT=8082
AUTH_SERVICE_PORT=3000

# Outgoing mail: the sign-up verification code (auth_service) and EMAIL notifications
# (trade_api). Both read these. Leave SMTP_HOST empty and no mail is sent: the sign-up
# code is written to the auth service log, and an EMAIL notification is marked FAILED
# with "no mail server". For Gmail use smtp.gmail.com, port 587, your address as
# SMTP_USER and an App Password (not your account password) as SMTP_PASSWORD.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Ferodha <no-reply@ferodha.local>
