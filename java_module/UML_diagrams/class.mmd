classDiagram
    direction TB

    %% Enums
    class UserStatus {
        <<enumeration>>
        PENDING
        ACTIVE
        SUSPENDED
        CLOSED
    }

    class InstrumentType {
        <<enumeration>>
        EQUITY
        BOND
        ETF
        FOREX
        CRYPTO
    }

    class OrderType {
        <<enumeration>>
        MARKET
        LIMIT
        STOP_LOSS
        TAKE_PROFIT
    }

    class OrderStatus {
        <<enumeration>>
        PENDING
        PARTIALLY_FILLED
        FILLED
        CANCELLED
        REJECTED
    }

    class OrderSide {
        <<enumeration>>
        BUY
        SELL
    }

    class TransactionType {
        <<enumeration>>
        DEPOSIT
        WITHDRAWAL
        BUY_SETTLEMENT
        SELL_SETTLEMENT
        DIVIDEND
    }

    %% Data Objects [Domain Models]
    class Role {
        +int role_id
        +string role_name
        +getRoleId() int
        +getRoleName() string
    }

    class User {
        +UUID user_id
        +string name
        +string email
        +string phone_number
        +string password_hash
        +UserStatus status
        +int role_id
        +DateTime created_at
        +DateTime last_login
        +canPlaceOrder() bool
        +canManageUser() bool
        +isAdvisor() bool
    }

    class Account {
        +UUID account_id
        +UUID user_id
        +UUID advisor_id
        +string bank_account_number
        +string currency
        +BigDecimal cash_balance
        +string state
        +DateTime created_at
        +depositCash(BigDecimal amount) void
        +withdrawCash(BigDecimal amount) bool
        +hasSufficientBalance(BigDecimal amount) bool
    }

    class ThirdPartyBank {
        +string bank_account_number
        +string email
        +string pin_hash
        +BigDecimal balance
        +verifyPin(string pin) bool
        +debit(BigDecimal amount) bool
        +credit(BigDecimal amount) void
    }

    class Instrument {
        +UUID instrument_id
        +string ticker
        +string name
        +string exchange
        +string currency
        +InstrumentType type
        +string sector
        +getTicker() string
    }

    class MarketData {
        +long market_data_id
        +UUID instrument_id
        +DateTime timestamp
        +BigDecimal open_price
        +BigDecimal close_price
        +BigDecimal high_price
        +BigDecimal low_price
        +getSpread() BigDecimal
    }

    class Order {
        +UUID order_id
        +UUID user_id
        +UUID account_id
        +UUID instrument_id
        +OrderSide side
        +OrderType order_type
        +BigDecimal limit_price
        +BigDecimal quantity
        +OrderStatus status
        +DateTime placed_at
        +string idempotency_key
        +validateOrder() bool
        +markFilled() void
        +markCancelled() void
    }

    class Trade {
        +UUID trade_id
        +UUID order_id
        +BigDecimal execution_price
        +BigDecimal execution_quantity
        +DateTime executed_at
        +string idempotency_key
        +getTotalValue() BigDecimal
    }

    class Transaction {
        +UUID transaction_id
        +UUID account_id
        +TransactionType transaction_type
        +BigDecimal amount
        +DateTime transaction_date
        +JSONB metadata
        +string idempotency_key
    }

    class Watchlist {
        +UUID watchlist_id
        +string name
        +UUID user_id
        +addItem(Instrument instrument) void
        +removeItem(UUID instrument_id) void
    }

    class WatchlistItem {
        +UUID item_id
        +UUID watchlist_id
        +UUID instrument_id
        +DateTime added_at
    }

    class Notification {
        +UUID notification_id
        +UUID user_id
        +JSONB payload
        +DateTime created_at
        +string idempotency_key
        +send() void
    }

    %% Position View
    class Position {
        +UUID position_id
        +UUID account_id
        +UUID instrument_id
        +BigDecimal quantity
        +BigDecimal average_price
        +BigDecimal market_value
        +BigDecimal unrealized_pnl_value
        +BigDecimal unrealized_pnl_percentage
        +calculatePnL(BigDecimal currentPrice) void
    }

    %% Services
    class IdempotencyManager {
        +checkAndRegisterKey(string idempotencyKey) bool
        +releaseKey(string idempotencyKey) void
    }

    class OrderMatchingEngine {
        +submitOrder(Order order) Trade
        +matchLimitOrders() List~Trade~
        +validateRiskLimits(Order order) bool
    }

    class PortfolioEngine {
        +calculatePositions(UUID accountId) List~Position~
        +getAccountAUM(UUID accountId) BigDecimal
        +getAdvisorAUM(UUID advisorId) BigDecimal
    }

    class BankingService {
        +initiateDeposit(UUID accountId, BigDecimal amount, string pin) Transaction
        +initiateWithdrawal(UUID accountId, BigDecimal amount, string pin) Transaction
        +settleTrade(Trade trade) Transaction
    }

    class NotificationService {
        +notifyUser(UUID userId, string eventType, JSONB message) void
    }

    %% Relationships and cardinality
    Role "1" -- "0..*" User : defines privilege scope %% A role is assigned to 0 or many users [there can be 0 clients or 500 at a given time]
    User "1" -- "0..*" Account : owns (Client)        %% A user might have an account [clients must have one, the rest not necessary]
    User "1" -- "0..*" Account : manages (Advisor)    %% Every user may or may not have an advisor
    User "1" -- "0..*" Watchlist : creates            %% Every user might create a watchlist - not necessary
    User "1" -- "0..*" Notification : receives        %% User might re ceive multiple Notifications
    User "1" -- "0..*" Order : places                 %% A user could place multiple orders
    
    ThirdPartyBank "1" -- "1..*" Account : linked clearing bank account %% Every account is linked to one ThirdPartyBank account
    
    Account "1" -- "0..*" Order : contains %% Every account may be containing orders
    Account "1" -- "0..*" Transaction : logs balance movements %% Every account might have a transaction log
    Account "1" -- "0..*" Position : dynamic holding view %% Every account might have some position

    Watchlist "1" -- "0..*" WatchlistItem : contains %% Every watchlist may have watchlist items
    Instrument "1" -- "0..*" WatchlistItem : added to %% An instrument can also be watched by many watchlists
    Instrument "1" -- "0..*" MarketData : price quotes history %% An instrument may have a marketdata associated with it
    Instrument "1" -- "0..*" Order : targeted by %% An instrument may be ordered multiple times

    Order "1" -- "0..*" Trade : generates execution(s) %% An order can have multiple trades
    Order "1" -- "1" Account : debits/credits asset %% An order is linked to one account
    Trade "1" -- "0..1" Transaction : triggers settlement %% A trade may have one or no transaction based on trigger

    %% Enum relationships
    User ..> UserStatus 
    Account ..> UserStatus
    Instrument ..> InstrumentType
    Order ..> OrderType
    Order ..> OrderStatus
    Order ..> OrderSide
    Transaction ..> TransactionType

    %% Service interactions
    OrderMatchingEngine ..> IdempotencyManager : checks key uniqueness
    OrderMatchingEngine ..> Order : processes
    OrderMatchingEngine ..> Trade : produces
    BankingService ..> Transaction : creates
    BankingService ..> ThirdPartyBank : debits/credits
    PortfolioEngine ..> Position : evaluates from Trades & MarketData