classDiagram
    direction TB

    class IdempotencyManager {
        <<interface>>
        +checkAndRegisterKey(String idempotencyKey) boolean
        +releaseKey(String idempotencyKey) void
    }

    class OrderMatchingEngine {
        <<interface>>
        +submitOrder(Order order) Trade
        +matchLimitOrders() List~Trade~
        +validateRiskLimits(Order order) boolean
    }

    class PortfolioEngine {
        <<interface>>
        +calculatePositions(UUID accountId) List~Position~
        +getAccountAUM(UUID accountId) BigDecimal
        +getAdvisorAUM(UUID advisorId) BigDecimal
    }

    class BankingService {
        <<interface>>
        +initiateDeposit(UUID accountId, BigDecimal amount, String pin) Transaction
        +initiateWithdrawal(UUID accountId, BigDecimal amount, String pin) Transaction
        +settleTrade(Trade trade) Transaction
    }

    class NotificationService {
        <<interface>>
        +notifyUser(UUID userId, String eventType, Object message) void
    }

    OrderMatchingEngine ..> IdempotencyManager : checks key uniqueness
    OrderMatchingEngine ..> Order : processes
    OrderMatchingEngine ..> Trade : produces
    BankingService ..> Transaction : creates
    BankingService ..> ThirdPartyBank : debits/credits
    PortfolioEngine ..> Position : evaluates
    NotificationService ..> Notification : sends

