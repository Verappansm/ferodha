classDiagram
    direction TB

    class Watchlist {
        +UUID watchlistId
        +String name
        +UUID userId
        +addItem(Instrument) void
        +removeItem(UUID instrumentId) void
        +containsInstrument(UUID) boolean
        +getSize() int
    }

    class WatchlistItem {
        +UUID itemId
        +UUID watchlistId
        +UUID instrumentId
        +LocalDateTime addedAt
    }

    class Notification {
        +UUID notificationId
        +UUID userId
        +Object payload
        +LocalDateTime createdAt
        +String idempotencyKey
        +send() void
    }

    class User {
        +UUID userId
        +String name
        +UserStatus status
    }

    class Instrument {
        +UUID instrumentId
        +String ticker
        +String name
    }

    User "1" -- "0..*" Watchlist : creates
    User "1" -- "0..*" Notification : receives
    Watchlist "1" -- "0..*" WatchlistItem : contains
    Instrument "1" -- "0..*" WatchlistItem : added to

