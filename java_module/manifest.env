JAVA_BASE_PACKAGE="com.trade"

# The 7 contractual exception cases, one class each, all extending
# com.trade.exception.DomainException.
JAVA_EXCEPTION_ACCOUNT_NOT_FOUND="AccountNotFoundException"
JAVA_EXCEPTION_ACCOUNT_NOT_ACTIVE="AccountNotActiveException"
JAVA_EXCEPTION_INSTRUMENT_NOT_FOUND="InstrumentNotFoundException"
JAVA_EXCEPTION_INSUFFICIENT_FUNDS="InsufficientFundsException"
JAVA_EXCEPTION_INSUFFICIENT_HOLDINGS="InsufficientHoldingsException"
JAVA_EXCEPTION_DUPLICATE_ORDER="DuplicateOrderException"
JAVA_EXCEPTION_INVALID_ORDER="InvalidOrderException"
