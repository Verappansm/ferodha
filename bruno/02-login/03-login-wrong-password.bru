meta {
  name: login wrong password
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/login
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "{{seedEmail}}",
    "password": "definitely-the-wrong-one"
  }
}

script:post-response {
  const b = res.getBody();
  const keys = Object.keys(b).sort().join(",");
  if (keys !== "errorCode,message") {
    throw new Error("failure body must be exactly the envelope, got: " + keys);
  }
}

assert {
  res.status: eq 401
  res.body.errorCode: eq AUTH-401
}
