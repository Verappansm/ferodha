meta {
  name: login wrong password
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/login
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "{{seedEmail}}",
    "password": "{{passwordDigest}}"
  }
}

script:post-response {
  const b = res.getBody();
  const keys = Object.keys(b).sort().join(",");
  if (keys !== "errorCode,message") {
    throw new Error("failure body must be exactly the envelope, got: " + keys);
  }
}

assert {
  res.status: eq 401
  res.body.errorCode: eq AUTH-401
}

script:pre-request {
  // B23: the browsers send sha256("ferodha-v1:" + lower-case email + ":"
  // + password) in place of the password, so this request does too.
  const CryptoJS = require("crypto-js");
  const digestEmail = String(bru.getEnvVar("seedEmail")).trim().toLowerCase();
  bru.setVar("passwordDigest", CryptoJS.SHA256(`ferodha-v1:${digestEmail}:${"definitely-the-wrong-one"}`).toString());
}
