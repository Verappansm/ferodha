meta {
  name: register username is not an email
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/auth/register
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Bruno Tester",
    "username": "priya.menon",
    "password": "correct horse battery staple"
  }
}

script:post-response {
  const b = res.getBody();
  const keys = Object.keys(b).sort().join(",");
  if (keys !== "errorCode,message") {
    throw new Error("failure body must be exactly the envelope, got: " + keys);
  }
}

assert {
  res.status: eq 422
  res.body.errorCode: eq VAL-422
}
