meta {
  name: refresh rotates
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/refresh
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "refreshToken": "{{refreshToken}}"
  }
}

script:post-response {
  // Keep the consumed token so request 04 can prove it is really dead.
  bru.setEnvVar("refreshTokenUsed", bru.getEnvVar("refreshToken"));
  const b = res.getBody();
  bru.setEnvVar("accessToken", b.accessToken);
  bru.setEnvVar("refreshToken", b.refreshToken);
}

assert {
  res.status: eq 200
  res.body.tokenType: eq Bearer
  res.body.expiresIn: eq 900
}
