meta {
  name: refresh chain revoked after reuse
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/auth/refresh
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "refreshToken": "{{refreshToken}}"
  }
}

script:post-response {
  const b = res.getBody();
  const keys = Object.keys(b).sort().join(",");
  if (keys !== "errorCode,message") {
    throw new Error("failure body must be exactly the envelope, got: " + keys);
  }
}

assert {
  res.status: eq 401
  res.body.errorCode: eq AUTH-401
}
