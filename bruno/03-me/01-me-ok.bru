meta {
  name: me with access token
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/auth/me
}

headers {
  Authorization: Bearer {{accessToken}}
}

script:post-response {
  const b = res.getBody();
  if (b.id !== bru.getEnvVar("userId")) {
    throw new Error("profile id must equal the registered id (the token's sub)");
  }
  if (b.username !== bru.getEnvVar("testEmail")) {
    throw new Error("profile username must be the email the user registered with");
  }
  if (b.accountId !== 1) {
    throw new Error("profile accountId must be the numeric Accounts.id (1)");
  }
  if (JSON.stringify(b.roles) !== '["CUSTOMER"]') {
    throw new Error("roles must be [CUSTOMER], got: " + JSON.stringify(b.roles));
  }
}

assert {
  res.status: eq 200
}
