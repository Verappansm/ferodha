meta {
  name: me with tampered token
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/auth/me
}

headers {
  Authorization: Bearer not-a-jwt.signature
}

script:post-response {
  const b = res.getBody();
  const keys = Object.keys(b).sort().join(",");
  if (keys !== "errorCode,message") {
    throw new Error("failure body must be exactly the envelope, got: " + keys);
  }
}

assert {
  res.status: eq 401
  res.body.errorCode: eq AUTH-401
}
