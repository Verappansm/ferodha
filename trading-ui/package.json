{
  "name": "trading-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve trading-ui",
    "build": "ng build trading-ui && ng build admin",
    "watch": "ng build --watch --configuration development",
    "test": "ng test trading-ui --watch=false && ng test admin --watch=false",
    "generate:api": "openapi-generator-cli generate",
    "check:api": "node scripts/check-api.mjs",
    "e2e": "playwright test",
    "e2e:debug": "playwright test --debug",
    "e2e:ui": "playwright test --ui",
    "demo": "playwright test -c playwright.demo.config.ts --project=present",
    "demo:check": "playwright test -c playwright.demo.config.ts --project=check",
    "start:admin": "ng serve admin --host 0.0.0.0 --allowed-hosts",
    "start:public": "ng serve trading-ui --host 0.0.0.0 --allowed-hosts"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "ag-charts-community": "^14.2.0",
    "ag-grid-angular": "^36.2.0",
    "ag-grid-community": "^36.2.0",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.4.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.0",
    "@openapitools/openapi-generator-cli": "2.41.0",
    "@playwright/test": "1.63.0",
    "@types/pg": "^8.23.1",
    "jsdom": "^28.0.0",
    "pg": "^8.23.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
