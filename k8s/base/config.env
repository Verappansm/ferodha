# NON-SECRET settings, given to trade-api, auth-service and trade-executor (ConfigMap
# ferodha-config). The names are the ones our services read (the root .env.example).
# Edit, then `kubectl apply -k k8s/base`: the ConfigMap's name carries a hash, so the
# pods restart with the new values by themselves. Secrets live in secrets.env.

# ---- database: the RDS instance ----
POSTGRES_HOST=database-1.c5omusos41a0.ap-south-1.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
# auth-service's node-pg turns SSL on only from this; RDS requires SSL.
PGSSLMODE=no-verify

# ---- kafka (kafka.yaml) ----
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# ---- the browser's address of the UI (gateway.yaml). Fill in after the load
# balancer exists (README step 7): http://<load-balancer-dns>:4200 ----
CORS_ALLOWED_ORIGINS=http://a8413d867ae01423e8e2833da6f18ac9-1132457196.ap-south-1.elb.amazonaws.com:4200

# ---- market data ----
FAUXNANCE_API_URL=https://y4t9nq2bqf.execute-api.eu-west-2.amazonaws.com/v1
# empty = fill-or-reject; market-sim = order book, partial fills, market maker
SPRING_PROFILES_ACTIVE=

# ---- the admin console's System Health page (service names, not localhost) ----
AUTH_HEALTH_URL=http://auth-service:3000/health
EXECUTOR_HEALTH_URL=http://trade-executor:8082/actuator/health

# ---- email: SMTP_HOST empty = no mail; sign-up codes are written to the
# auth-service log (kubectl -n ferodha logs deploy/auth-service) ----
SMTP_HOST=
SMTP_PORT=587
# development: a missing SMTP_HOST logs the code instead of failing the sign-up
NODE_ENV=development
