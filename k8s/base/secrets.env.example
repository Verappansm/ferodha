# SECRETS. Copy to secrets.env (git-ignored) and fill in; it becomes the Secret
# ferodha-secrets. The same values as the root .env.
POSTGRES_PASSWORD=replace-me
# at least 32 characters:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-random-secret-of-at-least-32-characters
FAUXNANCE_API_KEY=replace-me
# only with SMTP_HOST set in config.env (Gmail: your address and an App Password)
SMTP_USER=
SMTP_PASSWORD=
