# Copy this file to .env (git-ignored) and fill in real values.
# Never commit a real key -- .env is already in .gitignore.

# Application
NODE_ENV=development
PORT=3000

# JWT Secret (must be at least 32 characters for HS256)
JWT_SECRET=dev-only-jwt-signing-secret-please-change-later

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Fauxnance API (optional)
FAUXNANCE_API_URL=
FAUXNANCE_API_KEY=