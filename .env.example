# Copy this file to .env (git-ignored) and fill in real values.
# Never commit a real key -- .env is already in .gitignore.

# Fauxnance base URL, e.g. https://fauxnance.example.com/v1
FAUXNANCE_API_URL=
FAUXNANCE_API_KEY=

# Postgres, shared by database/apply.sh and trade_api.
# POSTGRES_HOST=localhost is correct when running trade_api directly
# (mvn spring-boot:run / the jar) with Postgres on this same machine.
# Running trade_api via docker-compose.yml instead: use host.docker.internal
# if Postgres is native on this machine, or the other container's
# name/service name if Postgres runs in Docker too - see docker-compose.yml.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# trade_api: HS256 signing secret shared with the auth service/stub.
# Never given a real value here or in any committed file.
# Must be at least 32 characters (256 bits) - RFC 7518 section 3.2 requires
# an HMAC-SHA256 key at least as long as the hash output, and JwtService
# refuses to start otherwise. Something like:
#   dev-only-jwt-signing-secret-please-change-later
# is long enough for local/dev use; use a real random value in any shared
# environment.
JWT_SECRET=
