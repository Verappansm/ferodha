# Copy this file to .env (git-ignored) and fill in real values.
# Never commit a real key -- .env is already in .gitignore.

# Fauxnance base URL, e.g. https://fauxnance.example.com/v1
FAUXNANCE_API_URL=
FAUXNANCE_API_KEY=

# Kafka, shared by trade_api (publishes ORDER_PLACED) and trade_executor
# (consumes ORDER_PLACED, publishes ORDER_FILLED/ORDER_REJECTED). Point this
# at the broker's advertised listener - see the root docker-compose.yml's
# kafka service for what's actually in use in this environment.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# trade_executor: reserved for the separate market-data poller, not used by
# the executor's own ORDER_PLACED consumption.
POLL_INTERVAL_SECONDS=60

# Empty/unset (default) = the spec-exact story this repo was built against:
# real Fauxnance quotes, fill-or-reject, no partial fills. Set to market-sim
# to switch on the market-simulation extension instead: order
# book matching with real partial fills, synthetic RANDOMIZER counter-orders,
# and TTL expiry of resting orders - see logic.md (gitignored, local only)
# for the full walkthrough. Read by trade-executor, pricing-generator and
# trades-generator (docker-compose.yml passes it to all three) - setting it on
# only some of them leaves the others out of sync with no error.
SPRING_PROFILES_ACTIVE=

# Postgres, shared by database/apply.sh, trade_api and auth_service.
# POSTGRES_HOST=localhost is correct when running trade_api directly
# (mvn spring-boot:run / the jar) with Postgres on this same machine.
# Running trade_api via docker-compose.yml instead: use host.docker.internal
# if Postgres is native on this machine, or the other container's
# name/service name if Postgres runs in Docker too - see docker-compose.yml.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# HS256 signing secret: auth_service signs with it, trade_api verifies with it.
# auth_service run from its own folder (npm run start:dev) reads this root .env
# too, via ../.env - there is no separate auth_service env file to keep in sync.
# Never given a real value here or in any committed file.
# Must be at least 32 characters (256 bits) - RFC 7518 section 3.2 requires
# an HMAC-SHA256 key at least as long as the hash output, and JwtService
# refuses to start otherwise. Something like:
#   dev-only-jwt-signing-secret-please-change-later
# is long enough for local/dev use; use a real random value in any shared
# environment.
JWT_SECRET=

# Outgoing mail: the sign-up verification code (auth_service) and EMAIL notifications
# (trade_api). Both read these. Leave SMTP_HOST empty and no mail is sent: the sign-up
# code is written to the auth service log, and an EMAIL notification is marked FAILED
# with "no mail server". For Gmail use smtp.gmail.com, port 587, your address as
# SMTP_USER and an App Password (not your account password) as SMTP_PASSWORD.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Ferodha <no-reply@ferodha.local>
