<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.trade.mapper.CandleMapper">

    <resultMap id="candleResultMap" type="com.trade.dto.CandleDto">
        <constructor>
            <arg column="candle_time" javaType="java.time.LocalDate" />
            <arg column="open" javaType="java.math.BigDecimal" />
            <arg column="high" javaType="java.math.BigDecimal" />
            <arg column="low" javaType="java.math.BigDecimal" />
            <arg column="close" javaType="java.math.BigDecimal" />
            <arg column="volume" javaType="java.lang.Long" />
        </constructor>
    </resultMap>

    <select id="findCandlesBySymbolAndInterval" resultMap="candleResultMap">
        SELECT
            candle_time,
            open,
            high,
            low,
            close,
            volume
        FROM market_candles
        WHERE symbol = #{symbol,jdbcType=VARCHAR}
          AND interval = #{interval,jdbcType=VARCHAR}
        ORDER BY candle_time DESC
    </select>

    <select id="countBySymbol" resultType="int">
        SELECT COUNT(*)
        FROM market_candles
        WHERE symbol = #{symbol,jdbcType=VARCHAR}
    </select>

</mapper>
