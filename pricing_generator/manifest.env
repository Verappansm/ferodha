# pricing-generator runtime environment.
# Copy these values into your shell (or a git-ignored .env you source)
# before `mvn -f pricing_generator/pom.xml spring-boot:run`.
# Fill in every empty value - never commit real secrets.
# Defaults shown in comments are what application.yml falls back to.

# --- Server ---
# Default if unset: 8084
SERVER_PORT=8084

# --- Postgres (no defaults for DB/USER/PASSWORD - all three are required) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- Kafka ---
# Default if unset: localhost:9092
KAFKA_BOOTSTRAP_SERVERS=
# Default if unset: market-data (this service only publishes pricing ticks)
KAFKA_TOPIC_MARKET_DATA=

# --- Fauxnance (no defaults - both are required) ---
# e.g. https://fauxnance.example.com/v1
FAUXNANCE_API_URL=
FAUXNANCE_API_KEY=

# --- Pricing schedules (all optional, defaults shown) ---
# Default: 86400 (candle high/low refresh, seconds)
GENERATOR_CANDLE_REFRESH_SECONDS=
# Default: 300 (real-quote anchor refresh, seconds)
GENERATOR_QUOTE_REFRESH_SECONDS=
# Default: 5 (synthetic tick interval, seconds)
GENERATOR_TICK_INTERVAL_SECONDS=
# Default: 0.0015 (fallback volatility per tick)
GENERATOR_DEFAULT_VOLATILITY=
# Default: 2000 (reference quota, requests/day)
GENERATOR_DAILY_QUOTA=
# Default: 25 (batch quote size, symbols/call)
GENERATOR_BATCH_SIZE=

# --- Spring profile (optional, empty by default) ---
SPRING_PROFILES_ACTIVE=
